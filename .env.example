# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: use when API is not served from the same origin/proxy
VITE_API_BASE_URL=http://localhost:4000

# Backend API server
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:8080

# Supabase server credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=optional-local-jwt-secret
AGENT_WEBHOOK_SECRET=replace-with-long-random-secret

# Supabase storage bucket for uploaded loan documents
SUPABASE_DOCS_BUCKET=loan-documents

# File-system path (project-relative) for ML model artifacts
ML_ASSETS_DIR=ml-artifacts

# OCR provider for document scan (placeholder | azure_document_intelligence)
OCR_PROVIDER=placeholder

# Azure Document Intelligence (required when OCR_PROVIDER=azure_document_intelligence)
# Example endpoint: https://your-resource-name.cognitiveservices.azure.com
OCR_AZURE_ENDPOINT=
OCR_AZURE_API_KEY=
OCR_AZURE_API_VERSION=2024-11-30
OCR_AZURE_MODEL_ID=prebuilt-read
# Optional locale hint, e.g. en, si, ta
OCR_AZURE_LOCALE=
OCR_AZURE_POLL_INTERVAL_MS=1500
OCR_AZURE_POLL_TIMEOUT_MS=60000
OCR_AZURE_REQUEST_TIMEOUT_MS=30000
