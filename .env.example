# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FRONTEND (Vite) — accessible as import.meta.env.VITE_*
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty when frontend and API are on the same origin (Railway single service).
# Set to http://localhost:4000 for local split-service development.
VITE_API_BASE_URL=http://localhost:4000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BACKEND — Node / Express server
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:8080

# Public base URL for generated share links (bank-agent access, etc.)
# Railway example: https://your-app.up.railway.app
APP_BASE_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SUPABASE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
AGENT_WEBHOOK_SECRET=replace-with-long-random-secret

# Storage bucket for uploaded loan documents
SUPABASE_DOCS_BUCKET=loan-documents

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ML
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ML_ASSETS_DIR=ml-artifacts
# Allow synthetic bootstrap outcomes in local/demo ML training pool.
# Automatically enabled outside production; leave blank to use defaults.
ML_ALLOW_SYNTHETIC_BOOTSTRAP=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI / GEMINI  (chat, document analysis, embeddings, speech-to-text)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Provider for the in-app AI chat assistant (disabled | gemini)
AI_CHAT_PROVIDER=gemini
# Gemini API key — get one at https://aistudio.google.com/app/apikey
AI_CHAT_GEMINI_API_KEY=
AI_CHAT_MODEL=gemini-2.5-flash

# Embedding model used for knowledge-base vector search
AI_EMBED_MODEL=gemini-embedding-001

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DOCUMENT AI  (optional — runs after OCR to verify doc type)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Set to gemini to enable AI-assisted document classification
DOCUMENT_AI_PROVIDER=disabled
# Re-uses AI_CHAT_GEMINI_API_KEY if left empty
DOCUMENT_AI_GEMINI_API_KEY=
DOCUMENT_AI_GEMINI_MODEL=gemini-2.5-flash
DOCUMENT_AI_TIMEOUT_MS=20000
DOCUMENT_AI_MIN_OCR_CHARS=120
DOCUMENT_AI_MAX_TEXT_CHARS=6000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OCR  (placeholder | tesseract | azure_document_intelligence | google_vision)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OCR_PROVIDER=placeholder

# --- Tesseract (free / local) ---
# Windows (scoop): C:\Users\<you>\scoop\shims\tesseract.exe
# Windows (installer): C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSERACT_COMMAND=tesseract
# Uncomment and set if Tesseract cannot find language data on Windows:
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
OCR_TESSERACT_LANGUAGE=eng
OCR_TESSERACT_PSM=3
OCR_TESSERACT_OEM=1
OCR_TESSERACT_TIMEOUT_MS=120000
OCR_PDFTOPPM_COMMAND=pdftoppm
OCR_PDF_DPI=200
OCR_PDF_MAX_PAGES=10

# --- Azure Document Intelligence ---
OCR_AZURE_ENDPOINT=
OCR_AZURE_API_KEY=
OCR_AZURE_API_VERSION=2024-11-30
OCR_AZURE_MODEL_ID=prebuilt-read
OCR_AZURE_LOCALE=
OCR_AZURE_POLL_INTERVAL_MS=1500
OCR_AZURE_POLL_TIMEOUT_MS=60000
OCR_AZURE_REQUEST_TIMEOUT_MS=30000

# --- Google Vision ---
# Cloud Vision API key (starts with AIza...)
OCR_GOOGLE_API_KEY=
OCR_GOOGLE_ENDPOINT=https://vision.googleapis.com/v1
OCR_GOOGLE_REQUEST_TIMEOUT_MS=30000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TELEGRAM BOT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Create a bot via @BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTO_START=true
TELEGRAM_POLL_INTERVAL_MS=2000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WHATSAPP  (disabled | twilio | whatsapp_web)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
WHATSAPP_PROVIDER=whatsapp_web

# --- WhatsApp Web (free / localhost — no Twilio needed) ---
WHATSAPP_WEB_SESSION_DIR=.wwebjs_auth
WHATSAPP_WEB_CLIENT_ID=loanflow
WHATSAPP_WEB_HEADLESS=true
WHATSAPP_WEB_EXECUTABLE_PATH=
WHATSAPP_WEB_AUTO_START=true
WHATSAPP_WEB_LOG_QR=true

# --- Twilio (required when WHATSAPP_PROVIDER=twilio) ---
# Account SID starts with AC; find both in Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio WhatsApp-enabled number, e.g. +14155238886
TWILIO_WHATSAPP_FROM_NUMBER=
# Public URL Twilio will POST webhooks to (e.g. https://api.example.com)
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VERIFY_SIGNATURE=true

# --- Voice / STT / TTS ---
WHATSAPP_STT_PROVIDER=gemini
WHATSAPP_TTS_PROVIDER=disabled
WHATSAPP_SEND_VOICE_REPLY=false
WHATSAPP_AUTO_VERIFY_LINK=true

# Required only when WHATSAPP_TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=
