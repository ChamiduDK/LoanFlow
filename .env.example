# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: use when API is not served from the same origin/proxy
VITE_API_BASE_URL=http://localhost:4000

# Backend API server
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:8080

# Supabase server credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=optional-local-jwt-secret
AGENT_WEBHOOK_SECRET=replace-with-long-random-secret

# Supabase storage bucket for uploaded loan documents
SUPABASE_DOCS_BUCKET=loan-documents
