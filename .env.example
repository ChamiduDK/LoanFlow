# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: only set this when the frontend is calling a different API origin.
# For a single Railway service that serves both frontend and API, leave this empty.
# Local example: http://localhost:4000
VITE_API_BASE_URL=

# Backend API server
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:8080
# Public frontend/app origin used for generated links (bank-agent access, etc.)
# Railway example: https://your-app.up.railway.app
APP_BASE_URL=

# Supabase server credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=optional-local-jwt-secret
AGENT_WEBHOOK_SECRET=replace-with-long-random-secret

# Supabase storage bucket for uploaded loan documents
SUPABASE_DOCS_BUCKET=loan-documents

# File-system path (project-relative) for ML model artifacts
ML_ASSETS_DIR=ml-artifacts

# OCR provider for document scan (placeholder | tesseract | azure_document_intelligence | google_vision)
OCR_PROVIDER=placeholder

# Tesseract OCR (free/local) - recommended if you want no cloud OCR cost
# Windows examples:
# OCR_TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_PDFTOPPM_COMMAND=C:\Program Files\poppler\Library\bin\pdftoppm.exe
OCR_TESSERACT_COMMAND=tesseract
# Optional on Windows: point to tessdata directory if Tesseract cannot load languages
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
OCR_TESSERACT_LANGUAGE=eng
OCR_TESSERACT_PSM=3
OCR_TESSERACT_OEM=1
OCR_TESSERACT_TIMEOUT_MS=120000
OCR_PDFTOPPM_COMMAND=pdftoppm
OCR_PDF_DPI=200
OCR_PDF_MAX_PAGES=10

# Azure Document Intelligence (required when OCR_PROVIDER=azure_document_intelligence)
# Example endpoint: https://your-resource-name.cognitiveservices.azure.com
OCR_AZURE_ENDPOINT=
OCR_AZURE_API_KEY=
OCR_AZURE_API_VERSION=2024-11-30
OCR_AZURE_MODEL_ID=prebuilt-read
# Optional locale hint, e.g. en, si, ta
OCR_AZURE_LOCALE=
OCR_AZURE_POLL_INTERVAL_MS=1500
OCR_AZURE_POLL_TIMEOUT_MS=60000
OCR_AZURE_REQUEST_TIMEOUT_MS=30000

# Google Vision OCR (required when OCR_PROVIDER=google_vision)
# Must be a Cloud Vision API key (typically starts with AIza)
OCR_GOOGLE_API_KEY=
OCR_GOOGLE_ENDPOINT=https://vision.googleapis.com/v1
OCR_GOOGLE_REQUEST_TIMEOUT_MS=30000

# Optional AI-assisted document verification (runs after OCR)
# Set to gemini to improve document type mismatch detection and rule-based verification from OCR text
DOCUMENT_AI_PROVIDER=disabled
DOCUMENT_AI_GEMINI_API_KEY=
DOCUMENT_AI_GEMINI_MODEL=gemini-2.0-flash-lite
DOCUMENT_AI_TIMEOUT_MS=20000
DOCUMENT_AI_MIN_OCR_CHARS=120
DOCUMENT_AI_MAX_TEXT_CHARS=6000

# Twilio WhatsApp + Voice integration
# For pure localhost simulation, these can stay empty and you can use
# /api/whatsapp/dev/simulate/* endpoints instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM_NUMBER=
# Public base URL used to verify Twilio signatures (example: https://api.example.com)
TWILIO_WEBHOOK_BASE_URL=
# Set false only for local testing without Twilio signature validation
TWILIO_VERIFY_SIGNATURE=true

# Voice note processing + optional voice replies
WHATSAPP_STT_PROVIDER=gemini
WHATSAPP_TTS_PROVIDER=disabled
WHATSAPP_SEND_VOICE_REPLY=false
WHATSAPP_AUTO_VERIFY_LINK=true

# Required only when WHATSAPP_TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=



